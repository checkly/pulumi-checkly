{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "alertChannel.ts",
        "apiCheck.ts",
        "browserCheck.ts",
        "check.ts",
        "checkGroup.ts",
        "checkGroupV2.ts",
        "clientCertificate.ts",
        "config/index.ts",
        "config/vars.ts",
        "dashboard.ts",
        "dnsMonitor.ts",
        "environmentVariable.ts",
        "getStaticIps.ts",
        "grpcMonitor.ts",
        "heartbeatCheck.ts",
        "heartbeatMonitor.ts",
        "icmpMonitor.ts",
        "index.ts",
        "maintenanceWindow.ts",
        "multistepCheck.ts",
        "playwrightCheckSuite.ts",
        "playwrightCodeBundle.ts",
        "privateLocation.ts",
        "provider.ts",
        "snippet.ts",
        "sslMonitor.ts",
        "statusPage.ts",
        "statusPageService.ts",
        "statusPageV3.ts",
        "statusPageV3AutomationRule.ts",
        "statusPageV3Component.ts",
        "tcpCheck.ts",
        "tcpMonitor.ts",
        "tracerouteMonitor.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "urlMonitor.ts",
        "utilities.ts"
    ]
}
